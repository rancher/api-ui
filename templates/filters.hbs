<div id="filter-body">
</div>
<div id="no-filters" class="inactive" {{#if hasFilters}}style="display: none;"{{/if}}>None</div>
{{#if canFilter}}
  <div class="filter-controls">
    <button type="button" class="btn btn-primary btn-sm" onclick="htmlapi.filterClear();"><span class="icon icon-close"></span> Clear</button>
    <button type="button" class="btn btn-primary btn-sm" onclick="htmlapi.filterAdd();"><span class="icon icon-circle-plus"></span> Add</button>
    <button type="submit" class="btn btn-primary btn-sm"><span class="icon icon-filter_alt"></span> Apply</button>
  </div>
{{/if}}
